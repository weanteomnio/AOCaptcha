{
    "name": "weanteomnio/aocaptcha",
    "description": "Embeddable drag-and-drop CAPTCHA widget with pluggable server-side storage.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "suggest": {
        "ext-redis": "Required to use weanteomnio\\AOCaptcha\\Storage\\RedisStorage."
    },
    "autoload": {
        "psr-4": {
            "weanteomnio\\AOCaptcha\\": "src/php/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "weanteomnio\\AOCaptcha\\Tests\\": "tests/php/"
        }
    }
}
